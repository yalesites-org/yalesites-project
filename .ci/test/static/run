#!/bin/bash

set -eo pipefail

#
# This script runs static tests which
# can be performed without code execution.
#
# Some example are code sniffing and unit testing
#

# Use the atomic branch matching this pull request branch if there is one,
# the same as the deploy job, so unit tests see the same atomic code.
./.ci/build/require_matching_atomic_branch

# Run composer install to get the vendor directory
composer install --no-ansi --no-interaction --optimize-autoloader --no-progress

npm install

# Run the PHPUnit Unit suite for custom modules (Kernel tests are not run in CI)
composer -n unit-test

# Lint php code for syntax errors
composer -n lint:php

# Check coding standards
composer -n code-sniff

# Lint styles and JS
npm run lint:styles
npm run lint:js
