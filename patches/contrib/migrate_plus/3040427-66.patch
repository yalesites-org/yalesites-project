+ * @endcode
+ *
+ * Example with callback:
+ * @code
+ * source:
+ *   plugin: url
+ *   data_fetcher_plugin: http
+ *   data_parser_plugin: json
+ *   urls:
+ *     callback: my_module_get_migration_urls
+ *   item_selector: /data
+ * @endcode
+ *
+ * The callback function signature:
+ * @code
+ * function my_module_get_migration_urls(\Drupal\migrate\Plugin\MigrationInterface $migration): array {
+ *   // Return array of URLs to process.
+ *   return ['https://example.com/api/item/1', 'https://example.com/api/item/2'];
+ * }
+ * @endcode
+ *
  * @MigrateSource(
  *   id = "url"
  * )
