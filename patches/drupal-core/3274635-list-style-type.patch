+  Drupal.behaviors.editorStyleFix = {
+    attach(context) {
+      // CKEditor's DLL injects <style data-cke> tags that override native
+      // list "type" attribute styling in the editing area. The following
+      // finds the style(s) causing the problem and removes them.
+      // @todo remove this entire behavior when this issue is fixed
+      //  https://github.com/ckeditor/ckeditor5/issues/14613
+      //
+      // CKEditor creates its editor instance (and injects these style tags)
+      // asynchronously, well after Drupal's synchronous attachBehaviors()
+      // pass runs, so a one-time DOM query at attach-time misses them. Use a
+      // MutationObserver instead, set up once per page, so this keeps
+      // working regardless of when (or how many times) CKEditor5 finishes
+      // initializing an editor instance.
+      function fixListStyleOverride(sheet) {
+        // Defensively wrapped: a stylesheet's cssRules can throw a
+        // SecurityError for a cross-origin sheet. An uncaught exception
+        // here would be an uncaught exception in a Drupal behavior,
+        // aborting attachment of every behavior queued after this one.
+        let rules;
+        try {
+          rules = [...sheet.cssRules];
+        } catch (e) {
+          return;
+        }
+        rules.forEach((rule) => {
+          if (!rule?.selectorText) {
+            return;
+          }
+          // Operate on each comma-separated selector independently: the
+          // off-canvas style-fencing logic elsewhere in this file combines
+          // a rule's original selector and an #drupal-off-canvas-prefixed
+          // duplicate of it into a single comma-separated selectorText, and
+          // a check or replacement anchored to the *whole* string (e.g.
+          // `!selectorText.includes('type')`, or a `$`-anchored regex)
+          // would only ever see/fix one half of that list.
+          const segments = rule.selectorText.split(',').map((s) => s.trim());
+          let changed = false;
+          const fixed = segments.map((selector) => {
+            if (
+              (selector.includes(' ol') || selector.includes(' ul')) &&
+              !selector.includes('type')
+            ) {
+              changed = true;
+              // Scope the rule to untyped lists only (append :not([type])
+              // to the list element the rule actually styles, i.e. the
+              // last token), rather than deleting the declaration
+              // outright. These rules implement CKEditor's own
+              // nesting-depth cascade (decimal -> lower-latin ->
+              // lower-roman), which is worth keeping for untyped
+              // sub-items; the only bug is that it unconditionally
+              // overrides a list that has an explicit `type` attribute,
+              // e.g. from the List Style dropdown.
+              return selector.replace(/\b(ol|ul)$/, '$1:not([type])');
+            }
+            return selector;
+          });
+          if (changed) {
+            try {
+              rule.selectorText = fixed.join(', ');
+            } catch (e) {
+              // Ignore: worst case this specific rule keeps overriding an
+              // explicit type attribute, same as before this fix existed.
+            }
+          }
+        });
+      }
+
+      function processCkeStyleNode(node) {
+        if (node.sheet) {
+          fixListStyleOverride(node.sheet);
+        } else {
+          node.addEventListener(
+            'load',
+            () => fixListStyleOverride(node.sheet),
+            { once: true },
+          );
+        }
+      }
+
+      // No `context` argument: this must run exactly once globally, the
+      // first time any editor attaches, regardless of whether that attach
+      // came from the initial page load or an AJAX/off-canvas response
+      // (whose fragment never contains an <html> element to match against).
+      if (once('editorStyleFix', 'html').length) {
+        document
+          .querySelectorAll('style[data-cke]')
+          .forEach(processCkeStyleNode);
+
+        new MutationObserver((mutations) => {
+          mutations.forEach((mutation) => {
+            mutation.addedNodes.forEach((node) => {
+              if (
+                node.nodeType === Node.ELEMENT_NODE &&
+                node.tagName === 'STYLE' &&
+                node.hasAttribute('data-cke')
+              ) {
+                processCkeStyleNode(node);
+              }
+            });
+          });
+        }).observe(document.head, { childList: true });
+
+        // Dialog-independent safety net: rather than rely on detecting
+        // every possible dialog wrapper a CKEditor5 instance might be
+        // rendered inside (off-canvas tray, core's generic AJAX modal,
+        // layout_builder_browser's own "Add block" modal, ...), apply the
+        // explicit-ancestor-type cascade unconditionally so it works
+        // regardless of which (if any) dialog triggered the editor.
+        const explicitAncestorCascadeCss = [
+          // Each starting type below is at or past some step into the
+          // decimal -> lower-alpha -> lower-roman (or disc -> circle ->
+          // square) sequence. A start at the beginning of the sequence
+          // (1/disc) continues advancing through it for 2/3 levels deep.
+          // A start already at or past the sequence's last step (a/i,
+          // circle/square) has no canonical next step to advance to, so it
+          // holds at that terminal style for every level below it instead
+          // of wrapping back to the start.
+          `.ck-content ol[type='1'] ol:not([type]) {list-style-type: lower-alpha}`,
+          `.ck-content ol[type='1'] ol:not([type]) ol:not([type]) {list-style-type: lower-roman}`,
+          `.ck-content ol[type='a'] ol:not([type]) {list-style-type: lower-roman}`,
+          `.ck-content ol[type='a'] ol:not([type]) ol:not([type]) {list-style-type: lower-roman}`,
+          `.ck-content ol[type='i'] ol:not([type]) {list-style-type: lower-roman}`,
+          `.ck-content ol[type='i'] ol:not([type]) ol:not([type]) {list-style-type: lower-roman}`,
+          `.ck-content ul[type='disc'] ul:not([type]) {list-style-type: circle}`,
+          `.ck-content ul[type='disc'] ul:not([type]) ul:not([type]) {list-style-type: square}`,
+          `.ck-content ul[type='circle'] ul:not([type]) {list-style-type: square}`,
+          `.ck-content ul[type='circle'] ul:not([type]) ul:not([type]) {list-style-type: square}`,
+          `.ck-content ul[type='square'] ul:not([type]) {list-style-type: square}`,
+          `.ck-content ul[type='square'] ul:not([type]) ul:not([type]) {list-style-type: square}`,
+        ].join('\n');
+        const explicitAncestorCascadeStyle = document.createElement('style');
+        explicitAncestorCascadeStyle.textContent = explicitAncestorCascadeCss;
+        explicitAncestorCascadeStyle.setAttribute(
+          'id',
+          'ckeditor5-explicit-ancestor-list-cascade',
+        );
+        document.head.appendChild(explicitAncestorCascadeStyle);
+      }
     },
   };
 
