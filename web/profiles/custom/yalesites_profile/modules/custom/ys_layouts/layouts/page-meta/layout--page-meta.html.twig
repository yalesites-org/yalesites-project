{#
/**
 * @file
 * Theme override to display a one-column layout.
 *
 * Available variables:
 * - in_preview: Whether the plugin is being rendered in preview mode.
 * - content: The content for this layout.
 * - attributes: HTML attributes for the layout <div>.
 * - show_secondary_nav: Whether or not to show the secondary nav.
 * - show_breadcrumbs: Whether or not to show the breadcrumb trail.
 * - section_theme: Section color option key; 'default' adds no markup.
 * - section_padding: Section padding option (default, no-top, no-bottom,
 *   no-padding); only applied when section_theme is set.
 */
#}
{%
  set classes = [
    'layout',
    'layout--onecol',
    'page-meta',
  ]
%}
{%
  set region_classes = [
    'layout__region',
    'layout__region--content',
  ]
%}

{% set hasContent = region_attributes.content %}
{% set region_attribute_classes = add_attributes({
  'class': region_classes
}) %}

{% if hasContent %}
  {% set region_attribute_classes = region_attributes.content.addClass(region_classes) %}
{% endif %}

{% if section_theme != 'default' %}
  {# Themed padding comes from the One column stylesheet (.layout--onecol). #}
  {{ attach_library('ys_layouts/ys_layout_onecol') }}
  {# Same signature a themed One column section emits (see yds-layout.twig), minus data-component-width: the children already carry their own site gutter, so adding it here would double it. #}
  {% set classes = classes|merge(['yds-layout']) %}
  {% set attributes = attributes.setAttribute('data-section-theme', section_theme).setAttribute('data-component-layout', 'one-column').setAttribute('data-component-padding', section_padding|default('default')) %}
{% endif %}

{% if content.page_meta %}
  <div{{ attributes.addClass(classes) }}>
    <div {{ region_attribute_classes }}>
      {% if show_breadcrumbs is not defined or show_breadcrumbs %}
        {{ drupal_entity('block', 'yalesitesbreadcrumbs', check_access=false) }}
      {% endif %}

      {% if show_secondary_nav %}
        {{ drupal_entity('block', 'atomic_custombooknavigation', check_access=false) }}
      {% endif %}
  
      {{ content.page_meta }}
    </div>
  </div>
{% endif %}
