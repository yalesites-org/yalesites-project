<?php

/**
 * @file
 * Contains ys_views_basic.module functions.
 */

use Drupal\block_content\BlockContentInterface;
use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\node\NodeInterface;
use Drupal\views\ViewExecutable;
use Drupal\ys_views_basic\Service\ExposedTaxonomyFilterOptions;
use Drupal\ys_views_basic\ViewsBasicManager;

/**
 * Implements hook_theme_suggestions_HOOK_alter() for block.
 *
 * The per-(content type, display mode) listing bundles created by the views
 * rework render identically to the legacy "view" block, but atomic registers
 * block templates by bundle machine name, so the new bundles have no template
 * and fall back to the default block render — printing the padding-options
 * field and losing the heading/CTA styling. Reuse atomic's
 * block--inline-block--view.html.twig for every listing bundle so they are a
 * drop-in replacement (no atomic change required).
 */
function ys_views_basic_theme_suggestions_block_alter(array &$suggestions, array $variables) {
  if (($variables['elements']['#base_plugin_id'] ?? NULL) !== 'inline_block') {
    return;
  }
  $bundle = _ys_views_basic_inline_block_bundle($variables['elements'], $variables['elements']['#derivative_plugin_id'] ?? NULL);
  if ($bundle !== NULL && isset(ViewsBasicManager::LISTING_BUNDLES[$bundle])) {
    // Appended last so it takes priority over the (template-less) per-bundle
    // suggestion and resolves to block--inline-block--view.html.twig.
    // Resource listings (#1723) reuse the old resource_view block's template
    // instead: its ys-resource-view wrapper is styled differently from
    // ys-view, and ys_views_basic_preprocess_block() hands it the params
    // field under the name it prints.
    // @todo Removed with ys_views_content_resources in the follow-up to
    //   yalesites-org/YaleSites-Internal#1723, once Atomic reads these bundles.
    $suggestions[] = _ys_views_basic_is_resource_listing($bundle)
      ? 'block__inline_block__resource_view'
      : 'block__inline_block__view';
  }
}

/**
 * Implements hook_preprocess_HOOK() for block.
 *
 * Atomic's block--inline-block--resource-view.html.twig prints
 * content.field_view_resource_params, the old resource_view bundle's params
 * field. The resource listing bundles store theirs in field_view_params, so
 * the rendered field is handed over under the name the template reads (#1723).
 *
 * @todo Remove with ys_views_content_resources in the follow-up to
 *   yalesites-org/YaleSites-Internal#1723, once Atomic reads field_view_params.
 */
function ys_views_basic_preprocess_block(array &$variables): void {
  $bundle = _ys_views_basic_inline_block_bundle($variables['elements'] ?? [], $variables['derivative_plugin_id'] ?? NULL);
  if (($variables['base_plugin_id'] ?? NULL) !== 'inline_block'
    || !_ys_views_basic_is_resource_listing($bundle)
    || !isset($variables['content']['field_view_params'])) {
    return;
  }
  $variables['content']['field_view_resource_params'] = $variables['content']['field_view_params'];
  unset($variables['content']['field_view_params']);
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for views_view.
 *
 * The resource scaffold view renders through atomic's content_resources view
 * template, so a migrated resource listing keeps its markup (#1723).
 *
 * @todo Remove with ys_views_content_resources in the follow-up to
 *   yalesites-org/YaleSites-Internal#1723, once Atomic has a template for it.
 */
function ys_views_basic_theme_suggestions_views_view_alter(array &$suggestions, array $variables): void {
  if ($variables['view']->id() === 'views_basic_scaffold_resources') {
    $suggestions[] = 'views_view__content_resources';
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for form.
 *
 * As above, for the resource scaffold view's exposed filter form: atomic
 * styles form--views--content-resources.html.twig, which formdazzle only
 * suggests for the content_resources view itself. ViewsExposedForm sets the
 * form's #theme from ViewExecutable::buildThemeFunctions(), which always
 * includes views_exposed_form__{view id}.
 *
 * @todo Remove with ys_views_content_resources in the follow-up to
 *   yalesites-org/YaleSites-Internal#1723, once Atomic has a template for it.
 */
function ys_views_basic_theme_suggestions_form_alter(array &$suggestions, array $variables): void {
  if (in_array('views_exposed_form__views_basic_scaffold_resources', (array) ($variables['element']['#theme'] ?? []), TRUE)) {
    $suggestions[] = 'form__views__content_resources';
  }
}

/**
 * Returns the bundle of the block content an inline block renders.
 *
 * Read from the rendered entity when the build carries it, so a placement
 * whose cached plugin id still names a migrated block's old bundle (e.g. a
 * node cached as inline_block:resource_view before deploy_10003 rewrote it)
 * is still recognised by its real bundle. Falls back to the derivative id.
 *
 * @param array $elements
 *   The block render element.
 * @param string|null $derivative
 *   The inline block derivative id (the bundle named by the plugin id).
 *
 * @return string|null
 *   The block content bundle id.
 */
function _ys_views_basic_inline_block_bundle(array $elements, ?string $derivative): ?string {
  $block = $elements['content']['#block_content'] ?? NULL;
  return $block instanceof BlockContentInterface ? $block->bundle() : $derivative;
}

/**
 * Returns whether a block content bundle is a resource listing bundle.
 *
 * @param string|null $bundle
 *   The block content bundle id.
 *
 * @return bool
 *   TRUE for the resource_* listing bundles.
 */
function _ys_views_basic_is_resource_listing(?string $bundle): bool {
  return $bundle !== NULL
    && (ViewsBasicManager::LISTING_BUNDLES[$bundle]['content_type'] ?? NULL) === ViewsBasicManager::CONTENT_TYPE_RESOURCE;
}

/**
 * Implements hook_theme().
 */
function ys_views_basic_theme($existing, $type, $theme, $path): array {
  return [
    // The default formatter will only be used for preview on the back-end.
    'views_basic_formatter_default' => [
      'variables' => [
        'view' => [],
        'exposed' => [],
      ],
    ],
    'views_basic_formatter_preview' => [
      'variables' => [
        'params' => [],
      ],
    ],
    'views_basic_rows' => [
      'variables' => [
        'card_collection_type' => NULL,
        'card_collection_modifiers' => [],
        'rows' => [],
        'parentNode' => NULL,
        'contentType' => NULL,
        // Card-size dial (#1648). Defaults to large so a listing rendered
        // without the setting looks exactly as it always has.
        'card_size' => ViewsBasicManager::CARD_SIZE_DEFAULT,
      ],
    ],
    'views_basic_events_calendar' => [
      'variables' => [
        'month_data' => [],
      ],
    ],
    // Authoring-form live mockup preview panel (#1318); see
    // ViewsBasicWidgetBase::buildPreviewPanel().
    'views_basic_mockup_preview' => [
      'variables' => [
        'content_type' => NULL,
        'view_mode' => NULL,
        'image_src' => NULL,
        'font_pairing' => NULL,
      ],
    ],
  ];
}

/**
 * Implements hook_views_data().
 */
function ys_views_basic_views_data_alter(array &$data) {
  $data['node_field_data']['views_basic_sort'] = [
    'title' => t('Views Basic Sort'),
    'sort' => [
      'help' => t('Creates a dynamic sort from Views Basic fields.'),
      'id' => 'views_basic_sort',
    ],
  ];
  $data['node_field_data']['exclude_taxonomy_terms'] = [
    'title' => t('Exclude Taxonomy Terms'),
    'filter' => [
      'help' => t('Excludes taxonomy terms dynamically from the views tool'),
      'id' => 'exclude_taxonomy_terms',
    ],
  ];
  $data['node_field_data']['event_time_period'] = [
    'title' => t('Event Time Period'),
    'filter' => [
      'help' => t('Show future, past, or all events'),
      'id' => 'event_time_period',
    ],
  ];
  $data['node_field_data']['post_year_filter'] = [
    'title' => t('Year'),
    'filter' => [
      'help' => t('Filter posts by year based on publish date.'),
      'id' => 'post_year_filter',
    ],
  ];
  // Also registered by ys_views_content_resources until that module is
  // removed; the two definitions are identical (#1723).
  $data['node_field_data']['resource_year_filter'] = [
    'title' => t('Published Year'),
    'filter' => [
      'help' => t('Filter resources by year based on published date.'),
      'id' => 'resource_year_filter',
    ],
  ];
  $data['node_field_data']['post_publish_date'] = [
    'title' => t('Post Publish Date'),
    'filter' => [
      'help' => t('Excludes posts whose publish date is in the future.'),
      'id' => 'post_publish_date',
    ],
  ];

  // The resource search swapped in when a block selects "Authors"; see
  // ViewsBasicManager::applyResourceFilters().
  $data['views']['resource_author_combine'] = [
    'title' => t('Resource search with authors'),
    'filter' => [
      'help' => t('Combine filter that also matches resource author names.'),
      'id' => 'ys_views_basic_resource_author_combine',
    ],
  ];

}

/**
 * Implements hook_views_pre_build().
 */
function ys_views_basic_views_pre_build($view) {
  static $counter = 0;

  if (empty($view->dom_id)) {
    $view->dom_id = "view_" . $counter++;
  }
}

/**
 * Implements hook_views_post_execute().
 *
 * Drops the pager of a listing that does not page, so none renders. Done here
 * rather than where the listing is configured because it has to follow
 * ViewExecutable::execute(), which builds the pager, on both paths: the block
 * render (ViewsBasicManager::setupView()) and the views/ajax re-render, which
 * only configures the view in ys_views_basic_views_pre_view() and lets the
 * controller run it.
 *
 * Per-listing display flags for the result rows are not set here or in
 * hook_views_pre_render(): see ViewsBasicDynamicStyle::render() and
 * \Drupal\ys_views_basic\ListingRowDisplay.
 */
function ys_views_basic_views_post_execute(ViewExecutable $view): void {
  if (!in_array($view->id(), ViewsBasicManager::SCAFFOLD_VIEWS, TRUE)) {
    return;
  }
  if (ViewsBasicManager::usesPagerFromArgs($view->args) === FALSE) {
    unset($view->pager);
  }
}

/**
 * Implements hook_views_pre_view().
 *
 * On the views/ajax path (exposed filters, AJAX pager) the browser sends the
 * view arguments back and core rebuilds the view from them. Configure it from
 * those arguments here; the controller then runs and renders it once.
 *
 * The block render configures and executes the view itself in
 * ViewsBasicManager::setupView() before ViewExecutable::preview() fires this
 * hook, so an executed view is left alone.
 */
function ys_views_basic_views_pre_view(ViewExecutable $view, $display_id, array &$args) {
  if (!in_array($view->id(), ViewsBasicManager::SCAFFOLD_VIEWS, TRUE) || !empty($view->executed)) {
    return;
  }

  // The stored params ride the arguments by name, never by position from the
  // end: original_settings is not the last argument, and taking the last one
  // handed the setup the wrong JSON (#1648). The arguments come from the
  // browser, so anything ViewsBasicManager::decodeParams() refuses, including
  // a short argument list, ends the view here instead of reaching the
  // plugins, which read these arguments by position.
  $params = $args[ViewsBasicManager::viewArgumentIndex('original_settings')] ?? NULL;
  $display = NULL;
  if (ViewsBasicManager::decodeParams($params) !== NULL) {
    // The stored params do not carry the host block's facts (heading
    // presence, UUID, host node): the full-page render resolves those from
    // the block entity and the page route. Recover them from the incoming
    // arguments so the re-render keeps the same result-card heading level,
    // reads ?page= at the same pager element, and leaves out the same host
    // page as the initial render (#1921).
    $context = ViewsBasicManager::incomingDisplayContext($args);
    $display = \Drupal::service('ys_views_basic.views_basic_manager')->configureView(
      $view,
      $params,
      $context['block_uuid'],
      $context['block_has_heading'],
      $context['host_nid'],
      ViewsBasicManager::listingKeyFromArgs($args),
    );
  }
  if ($display === NULL) {
    _ys_views_basic_fail_view($view);
  }
}

/**
 * Stops a view from building, running or rendering.
 *
 * ViewExecutable::build() resets build_info, so a failure flagged before the
 * build would be lost. Marking the view built and executed as well makes
 * ViewExecutable::render() skip straight to the failure check and return
 * nothing.
 *
 * @param \Drupal\views\ViewExecutable $view
 *   The view.
 */
function _ys_views_basic_fail_view(ViewExecutable $view): void {
  $view->build_info['fail'] = TRUE;
  $view->built = TRUE;
  $view->executed = TRUE;
  $view->result = [];
}

/**
 * Implements hook_node_view().
 */
function ys_views_basic_node_view(array &$build, NodeInterface $node, EntityViewDisplayInterface $display, $view_mode) {
  $view_modes = [
    "card",
    "portrait_grid",
    "condensed",
    "list_item",
  ];

  if (in_array($view_mode, $view_modes)) {
    $build['#cache']['max-age'] = 0;
  }
}

/**
 * Implements hook_form_alter().
 *
 * Unifies the listing-block authoring form (Layout Builder add/update block)
 * into a single horizontal tab bar: General | Results & filters |
 * Tags, sorting & pinned | Display options.
 *
 * The last three tabs are the field widget's own inner "details" groups
 * (ViewsBasicWidgetBase::initSelectionContainers()); "General" collects the
 * outer block fields (heading, heading links, padding, admin title, reusable,
 * and — as of #1481 — the block's Title/label fields, with the redundant
 * "Block description" item hidden below).
 * Because the widget groups live inside the field_view_params widget,
 * field_group (which is driven by form-display config) cannot reach them, so
 * the grouping is done here with core's #group mechanism instead.
 *
 * The tab set and the General group are built in a #process callback appended
 * to the content-block subform, because the block fields do not exist until
 * that subform's own #process (InlineBlock::processBlockForm()) has run. The
 * root-level reusable/admin-title/label fields are attached to the General
 * group here in the alter — before form processing begins — so their #group
 * is set before their own #process runs, regardless of the order in which the
 * form tree is processed. ys_layouts_form_alter() relabels the reusable/info
 * pair and wraps it in a toggle row container; this hook only groups that
 * container, so the two do not conflict.
 */
function ys_views_basic_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  if ($form_id !== 'layout_builder_add_block' && $form_id !== 'layout_builder_update_block') {
    return;
  }

  // The inline-block authoring form nests the content-block subform under
  // 'settings'; a reusable (block_content) block places it at the top level.
  if (isset($form['settings']['block_form'])) {
    $block_form = &$form['settings']['block_form'];
  }
  elseif (isset($form['block_form'])) {
    $block_form = &$form['block_form'];
  }
  else {
    return;
  }

  // Only listing-view blocks get the tabbed layout.
  $block = $block_form['#block'] ?? NULL;
  if (!$block instanceof BlockContentInterface || !isset(ViewsBasicManager::LISTING_BUNDLES[$block->bundle()])) {
    return;
  }

  // Attach the root-level reusable/admin-title fields (inline-block only) to
  // the General tab. Weights place them below the content fields within it.
  // ys_layouts_form_alter() wraps the pair in a toggle/disclosure row
  // container (#1481), so the container is what gets grouped; the fields are
  // grouped one by one only if that wrapper is absent.
  $reusable_keys = isset($form['reusable_toggle']) ? ['reusable_toggle' => 20] : ['reusable' => 20, 'info' => 21];
  foreach ($reusable_keys as $key => $weight) {
    if (isset($form[$key])) {
      $form[$key]['#group'] = 'group_listing_general';
      $form[$key]['#weight'] = $weight;
    }
  }

  // Move the block "Title" (label/label_display) fields into the General tab
  // too (#1481): unlike info/reusable above, these live one level deeper, at
  // $form['settings']['label'] and $form['settings']['label_display'] — the
  // visible "Administrative label" field is not $form['info']. #group works
  // the same way on these (plain textfield/checkbox render elements, not
  // field-widget wrappers), so no physical move is needed, only #group.
  foreach (['label' => 22, 'label_display' => 23] as $key => $weight) {
    if (isset($form['settings'][$key])) {
      $form['settings'][$key]['#group'] = 'group_listing_general';
      $form['settings'][$key]['#weight'] = $weight;
    }
  }

  // Hide the static "Block description" item (#1481): it restates the block
  // type the editor just picked in the block picker (e.g. "Posts - Card Grid
  // View"), duplicating the value the label field above now prefills.
  if (isset($form['settings']['admin_label'])) {
    $form['settings']['admin_label']['#access'] = FALSE;
  }

  $block_form['#process'][] = '_ys_views_basic_listing_form_tabs';

  // Space out the horizontal tab bar (Gin collapses the field_group defaults).
  $form['#attached']['library'][] = 'ys_views_basic/listing_form_tabs';
}

/**
 * Process callback: gathers the listing-block fields into one tab bar.
 *
 * Runs after the content-block subform is built, so the field widgets and the
 * widget's inner group details are present. Adds a horizontal_tabs element and
 * a "General" details, then attaches the four groups to the tab bar via
 * #group. The widget's three details self-register as group members (details
 * elements run RenderElement::processGroup()); the plain field wrappers do
 * not, so they are moved into the General details instead. Their #parents were
 * assigned at widget-build time and survive the move (FormBuilder only assigns
 * #parents when unset), so the stored form values are unaffected.
 *
 * @param array $element
 *   The content-block subform element.
 * @param \Drupal\Core\Form\FormStateInterface $form_state
 *   The current state of the form.
 * @param array $complete_form
 *   The complete form structure.
 *
 * @return array
 *   The processed subform element.
 */
function _ys_views_basic_listing_form_tabs(array $element, FormStateInterface $form_state, array &$complete_form): array {
  // The widget's inner groups only exist once the entity form has been built.
  if (!isset($element['group_user_selection'])) {
    return $element;
  }

  $tabs = 'group_listing_tabs';
  $general = 'group_listing_general';

  // The single tab bar. An explicit #parents fixes the group identifier that
  // member details reference via #group, independent of tree position.
  $element[$tabs] = [
    '#type' => 'horizontal_tabs',
    '#parents' => [$tabs],
    '#weight' => 1,
  ];

  // "General": the outer block fields. field_heading, field_heading_links and
  // field_padding_options are moved in physically because field wrappers do
  // not self-register with #group; the reusable toggle row is attached by
  // #group in the form alter above.
  $element[$general] = [
    '#type' => 'details',
    '#title' => t('General'),
    '#group' => $tabs,
    '#parents' => [$general],
    '#weight' => 0,
    '#open' => TRUE,
  ];
  // Explicit weights guarantee heading, then links, then padding options,
  // regardless of whatever weights each bundle's own form display happens
  // to have configured for these three fields.
  $field_weights = [
    'field_heading' => 0,
    'field_heading_links' => 1,
    'field_padding_options' => 2,
  ];
  foreach ($field_weights as $field => $weight) {
    if (isset($element[$field])) {
      $element[$general][$field] = $element[$field];
      $element[$general][$field]['#weight'] = $weight;
      unset($element[$field]);
    }
  }

  // Links is up to 3 optional rows most blocks never touch — collapsed by
  // default so it doesn't dominate the General tab on first paint. The
  // field's own build array keeps its #parents (set at widget-build time),
  // so nesting it one level deeper here doesn't change where its submitted
  // value is read from, same as the physical move above.
  if (isset($element[$general]['field_heading_links'])) {
    $links_field = $element[$general]['field_heading_links'];
    // WidgetBase::form() wraps every field in an outer #type container (the
    // 'field--name-...' classified wrapper) with the actual multi-value
    // build nested one level deeper under its own 'widget' key — #title
    // lives on that inner array, not the outer container this variable
    // starts out as. Setting #title on the wrong (outer) level here doesn't
    // error, it just silently does nothing, leaving the field's own table
    // heading printed as normal.
    // "Header links" rather than the field's own shared config label ("Links",
    // field.field.block_content.*.field_heading_links.yml) — that label is
    // used platform-wide across every block type this field appears on, not
    // just listing blocks, so it's overridden here rather than renamed in
    // config (#1481, same scope reasoning as leaving "Administrative label"
    // alone in ys_layouts_form_alter()).
    $title = t('Header links');
    // The field's own multi-value table already prints this as a heading;
    // avoid showing it twice once the details summary carries it instead.
    if (isset($links_field['widget']['#title'])) {
      $links_field['widget']['#title'] = '';
    }
    $element[$general]['field_heading_links'] = [
      '#type' => 'details',
      '#title' => $title,
      '#open' => FALSE,
      '#weight' => $field_weights['field_heading_links'],
      // Styling hook for views-basic-form-tabs.css: this nested details
      // doesn't need the tab-pane-edge padding gin_lb puts on every
      // .glb-claro-details__wrapper, since it isn't a tab-bar-level pane.
      '#attributes' => ['class' => ['vb-heading-links-details']],
      'widget' => $links_field,
    ];
  }

  // The remaining three tabs are the widget's existing inner details groups.
  // Their keys, contents and #parents stay unchanged, so massageFormValues()'s
  // fixed paths still resolve; only #group (and the active-tab #open flag) are
  // set here.
  // Weight the widget groups after General (#weight 0) so the bar reads
  // General | Field display & filters | Tags, sorting & pinned |
  // Display options.
  $group_weight = 1;
  foreach (['entity_and_view_mode', 'filter_and_sort', 'options'] as $group) {
    if (isset($element['group_user_selection'][$group])) {
      $element['group_user_selection'][$group]['#group'] = $tabs;
      $element['group_user_selection'][$group]['#open'] = FALSE;
      $element['group_user_selection'][$group]['#weight'] = $group_weight++;
    }
  }

  // Those three groups now render inside the tab bar via #group (the event
  // time-period control lives in the "options" group, so it moves into the
  // Display options tab too). What remains directly under group_user_selection
  // is only empty helper containers, so it renders as a stray empty <div>; drop
  // the wrapper so nothing is emitted.
  $element['group_user_selection']['#theme_wrappers'] = [];

  return $element;
}

/**
 * Implements hook_form_views_exposed_form_alter().
 *
 * Replaces an exposed taxonomy filter that has no choices with a message.
 * This replaces the old YaleSites-Internal#162 rule that hid such filters.
 *
 * On the scaffold views, also adds a hidden field naming the listing, so a
 * no-JS submit carries it in the URL and only that listing applies the filter
 * values (YaleSites-Internal#1926). The listing_ajax library does the same for
 * a submit with JS on.
 */
function ys_views_basic_form_views_exposed_form_alter(array &$form, FormStateInterface $form_state): void {
  $view = $form_state->get('view');
  // Same listing family as ys_core_form_views_exposed_form_alter().
  $listing_views = [...ViewsBasicManager::SCAFFOLD_VIEWS, 'content_resources'];
  if (!in_array($view->id(), $listing_views, TRUE)) {
    return;
  }
  // content_resources builds its own, different argument list.
  if (in_array($view->id(), ViewsBasicManager::SCAFFOLD_VIEWS, TRUE)) {
    $listing_key = ViewsBasicManager::listingKeyFromArgs($view->args);
    if ($listing_key !== NULL) {
      $form[ViewsBasicManager::LISTING_QUERY_KEY] = [
        '#type' => 'hidden',
        '#value' => $listing_key,
      ];
      // Stops the JS submit re-sending the page's own query (#1926).
      $form['#attached']['library'][] = 'ys_views_basic/listing_ajax';
    }
  }
  foreach ($view->filter as $handler) {
    if ($handler->getPluginId() !== 'taxonomy_index_tid' || !$handler->isExposed()) {
      continue;
    }
    $identifier = $handler->options['expose']['identifier'];
    if (($form[$identifier]['#type'] ?? '') !== 'select') {
      continue;
    }
    // Core adds an "All" option to single-value, non-required filters.
    if (array_diff_key($form[$identifier]['#options'] ?? [], ['All' => TRUE])) {
      continue;
    }
    // Carry over #weight only when the select had one: adding a default 0
    // moves the message ahead of its unweighted siblings.
    $form[$identifier] = ExposedTaxonomyFilterOptions::emptyFilterElement(
      $form[$identifier]['#title'] ?? $handler->options['expose']['label']
    ) + array_intersect_key($form[$identifier], array_flip(['#weight']));
  }
}
