<?php

/**
 * @file
 * Single-entry wizard for the Layout Builder listing blocks.
 *
 * The views rework gives every (content type, display mode) pair its own
 * block_content bundle, which is the right architecture but puts one tile per
 * bundle in the Layout Builder block picker. This module collapses those tiles
 * into a single "Content Listing" entry that asks the two questions the pair
 * encodes - which content type, and which display mode - and then hands off to
 * the matching bundle's own configure form.
 *
 * The module is an optional add-on to ys_views_basic: it reads its options,
 * labels and icons from ViewsBasicManager, and ys_views_basic works unchanged
 * when this module is not installed.
 *
 * See README.md for the handoff mechanics and the contrib seams involved.
 */

use Drupal\Component\Serialization\Json;
use Drupal\Component\Utility\Html;
use Drupal\Core\Url;
use Drupal\ys_views_wizard\ViewsWizardOptions;

/**
 * Implements hook_layout_builder_browser_alter().
 *
 * This is the insertion point that needs no patch and no route override: the
 * browser hands us the finished render array plus the section storage, delta
 * and region, which are exactly the parameters the wizard route needs.
 *
 * Every listing tile is removed and replaced by one entry in the module's own
 * category, which is a layout_builder_browser_blockcat config entity shipped
 * in config/install - so the category label and weight are editable in the
 * block browser UI rather than being frozen in code. Categories this hook
 * empties are dropped, since the browser itself drops empty categories and
 * leaving them behind would render as empty accordions.
 *
 * Event Calendar is deliberately untouched: it is not a listing bundle.
 */
function ys_views_wizard_layout_builder_browser_alter(array &$build, array $contexts) {
  $wizard_url = Url::fromRoute('ys_views_wizard.choose', [
    'section_storage_type' => $contexts['section_storage']->getStorageType(),
    'section_storage' => $contexts['section_storage']->getStorageId(),
    'delta' => $contexts['delta'],
    'region' => $contexts['region'],
  ]);

  $listing_plugins = ViewsWizardOptions::listingPluginIds();
  $wizard_link = NULL;
  $anchor_category = NULL;
  $emptied_categories = [];

  foreach ($build['block_categories'] as $category_key => &$category) {
    if (!is_array($category) || !isset($category['links'])) {
      continue;
    }
    foreach ($category['links'] as $index => $item) {
      if (!isset($item['link']['#url'])) {
        continue;
      }
      $parameters = $item['link']['#url']->getRouteParameters();
      if (!isset($listing_plugins[$parameters['plugin_id'] ?? ''])) {
        continue;
      }
      // The first listing tile becomes the template for the single wizard
      // entry, so the entry inherits the browser's own image, classes and
      // container markup instead of being rebuilt from scratch.
      if ($wizard_link === NULL) {
        $wizard_link = $item;
        $wizard_link['link']['#url'] = $wizard_url;
        $wizard_link['link']['#title']['label']['#markup'] = ViewsWizardOptions::LINK_LABEL;
        // layout_builder_browser_link_alter() only modalises the two core
        // layout_builder route names, so a custom route would open off-canvas
        // from inside the modal. Set the dialog attributes here instead.
        _ys_views_wizard_modalize($wizard_link['link']['#attributes']);
        // Remember where the listings started so the new category can take
        // that slot rather than being appended after unrelated categories.
        $anchor_category = $category_key;
      }
      unset($category['links'][$index]);
    }
    $category['links'] = array_values($category['links']);
    if (!$category['links']) {
      $emptied_categories[] = $category_key;
    }
  }
  // Break the reference before touching the array again.
  unset($category);

  if ($wizard_link === NULL) {
    return;
  }

  $wizard_category = _ys_views_wizard_category();
  if ($wizard_category === NULL) {
    return;
  }
  $wizard_category['links'] = [$wizard_link];

  // Splice BEFORE dropping the emptied categories, while the anchor is still
  // in the array. The anchor is usually emptied and dropped itself - it is the
  // category the first listing tile came out of - so resolving its position
  // afterwards would always miss and fall through to appending, which puts the
  // entry after unrelated categories rather than where the listings were.
  $build['block_categories'] = _ys_views_wizard_splice(
    $build['block_categories'],
    ViewsWizardOptions::CATEGORY_ID,
    $wizard_category,
    $anchor_category
  );

  foreach ($emptied_categories as $category_key) {
    unset($build['block_categories'][$category_key]);
  }
}

/**
 * Builds the wizard's block browser category from its config entity.
 *
 * Mirrors the category render array BrowserController::browse() builds, so the
 * single entry sits in an accordion indistinguishable from the browser's own.
 * The controller drops any category with no blocks behind it, and the wizard's
 * category has none by design, so it never survives into $build on its own -
 * this rebuilds it.
 *
 * @return array|null
 *   The category render array, or NULL when the config entity is missing.
 */
function _ys_views_wizard_category(): ?array {
  $blockcat = \Drupal::entityTypeManager()
    ->getStorage('layout_builder_browser_blockcat')
    ->load(ViewsWizardOptions::CATEGORY_ID);

  if (!$blockcat || !$blockcat->status()) {
    return NULL;
  }

  return [
    '#type' => 'details',
    '#attributes' => ['class' => ['js-layout-builder-category']],
    '#open' => $blockcat->getOpened(),
    '#title' => Html::escape($blockcat->label()),
  ];
}

/**
 * Inserts a category into the browser build at another category's position.
 *
 * $build['block_categories'] mixes render properties (#type, #attributes) with
 * category keys, and its order IS the rendered order - the browser assigns
 * categories sequentially after sorting, and nothing re-sorts afterwards. So
 * inserting at a position means rebuilding the array rather than sorting it.
 *
 * @param array $categories
 *   The block_categories render array.
 * @param string $id
 *   The key to insert under.
 * @param array $category
 *   The category render array to insert.
 * @param string|null $anchor
 *   The key to insert in front of. When it is absent - which is what happens
 *   when the anchor category was emptied and dropped - the category is
 *   appended.
 *
 * @return array
 *   The rebuilt block_categories render array.
 */
function _ys_views_wizard_splice(array $categories, string $id, array $category, ?string $anchor): array {
  if ($anchor === NULL || !array_key_exists($anchor, $categories)) {
    return $categories + [$id => $category];
  }

  $rebuilt = [];
  foreach ($categories as $key => $value) {
    if ($key === $anchor) {
      $rebuilt[$id] = $category;
    }
    $rebuilt[$key] = $value;
  }
  return $rebuilt;
}

/**
 * Applies layout_builder_browser's modal attributes to a link.
 *
 * Mirrors layout_builder_browser_link_alter(), which cannot help here because
 * it whitelists only layout_builder.choose_block and layout_builder.add_block.
 *
 * @param array $attributes
 *   The link's #attributes array, altered by reference.
 */
function _ys_views_wizard_modalize(array &$attributes) {
  if (!\Drupal::config('layout_builder_browser.settings')->get('use_modal')) {
    return;
  }
  if (!in_array('use-ajax', $attributes['class'] ?? [], TRUE)) {
    return;
  }
  $attributes['data-dialog-type'] = 'dialog';
  $attributes['data-dialog-options'] = Json::encode([
    'width' => '80%',
    'height' => 'auto',
    'target' => 'layout-builder-modal',
    'autoResize' => TRUE,
    'modal' => TRUE,
  ]);
  unset($attributes['data-dialog-renderer']);
}

/**
 * Implements hook_gin_lb_is_layout_builder_route_alter().
 *
 * The route half of the gin_lb opt-in; the form-id half needs a service
 * decorator because gin_lb fires no alter there. See GinLbContextValidator.
 */
function ys_views_wizard_gin_lb_is_layout_builder_route_alter(bool &$is_layout_builder_route) {
  if (\Drupal::routeMatch()->getRouteName() === 'ys_views_wizard.choose') {
    $is_layout_builder_route = TRUE;
  }
}
