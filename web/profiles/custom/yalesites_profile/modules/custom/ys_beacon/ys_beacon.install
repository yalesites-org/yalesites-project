<?php

/**
 * @file
 * Install and update functions for the ys_beacon module.
 */

use Drupal\ys_beacon\Service\GuardrailTelemetry;
use Drupal\ys_beacon\Service\SuspectTurnLog;
use Drupal\Core\Config\FileStorage;
use Drupal\Core\Database\Connection;

/**
 * Implements hook_schema().
 */
function ys_beacon_schema() {
  $schema['ys_beacon_system_instructions'] = [
    'description' => 'Stores system instructions for the Beacon chat assistant with versioning.',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'not null' => TRUE,
        'description' => 'Primary key.',
      ],
      'instructions' => [
        'type' => 'text',
        'size' => 'big',
        'not null' => TRUE,
        'description' => 'The system instructions content.',
      ],
      'version' => [
        'type' => 'int',
        'not null' => TRUE,
        'description' => 'Version number of the instructions.',
      ],
      'created_by' => [
        'type' => 'int',
        'not null' => TRUE,
        'description' => 'User ID who created this version.',
      ],
      'created_date' => [
        'type' => 'int',
        'not null' => TRUE,
        'description' => 'Unix timestamp when this version was created.',
      ],
      'is_active' => [
        'type' => 'int',
        'size' => 'tiny',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Whether this version is currently active.',
      ],
      'notes' => [
        'type' => 'text',
        'size' => 'medium',
        'not null' => FALSE,
        'description' => 'Optional notes about this version.',
      ],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'version' => ['version'],
      'created_by' => ['created_by'],
      'created_date' => ['created_date'],
      'is_active' => ['is_active'],
    ],
    'foreign keys' => [
      'created_by' => [
        'table' => 'users',
        'columns' => ['created_by' => 'uid'],
      ],
    ],
  ];

  $schema[GuardrailTelemetry::TABLE] = [
    'description' => 'Aggregate daily counts of guardrail-relevant Beacon chat events. Counters only - by design there is no column a question or an answer could be stored in.',
    'fields' => [
      'bucket_date' => [
        'type' => 'varchar',
        'length' => 10,
        'not null' => TRUE,
        'description' => 'UTC day the events were counted in, as YYYY-MM-DD.',
      ],
      'event_key' => [
        'type' => 'varchar',
        'length' => 160,
        'not null' => TRUE,
        'description' => 'Event type, optionally suffixed with a .dimension breakdown such as plugin.<label> or pattern.<name>.',
      ],
      'event_count' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
        'description' => 'How many times the event was recorded that day.',
      ],
    ],
    // The composite primary key is what makes the counter safe under
    // concurrency: it turns a racing insert into a constraint violation that
    // Merge recovers from with an atomic increment instead of a lost count.
    'primary key' => ['bucket_date', 'event_key'],
  ];

  $schema[SuspectTurnLog::TABLE] = [
    'description' => 'When a chat turn was flagged as suspicious - the question matched a known prompt-injection pattern, or a guardrail stopped the turn - and why. Counters and reasons only: like the table above, there is no column a question or an answer could be written into. Pruned after SuspectTurnLog::RETENTION_DAYS days and readable only with the "view ys beacon guardrail telemetry" permission.',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'not null' => TRUE,
        'description' => 'Primary key.',
      ],
      'created' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Unix timestamp the turn was served, used to order and to expire rows.',
      ],
      'pattern' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
        'default' => '',
        'description' => 'Why the turn was kept: the GuardrailSignalDetector injection pattern the question matched, or SuspectTurnLog::REASON_GUARDRAIL_STOP when a guardrail stopped it.',
      ],
    ],
    'primary key' => ['id'],
    // Every read, the per-day write quota and the retention prune all filter on
    // created, so it carries the only index this table needs.
    'indexes' => [
      'created' => ['created'],
    ],
  ];

  return $schema;
}

/**
 * Implements hook_install().
 *
 * Copies the editor-facing display settings from the legacy ai_engine chat
 * the first time this module is installed. Connection settings (Portkey,
 * Azure index) are not copied; they are configured fresh through the Beacon
 * administration form.
 *
 * Also copies the per-site system instructions version history from the
 * legacy ys_ai_system_instructions table when that module is (or was)
 * installed, so the history survives its removal.
 *
 * Key entities are NOT created here. The four platform-secret keys
 * (portkey_llm_api_key, portkey_embedding_api_key, azure_ai_search_api_key,
 * azure_ai_search_url) ship as key.key.* config and are created by
 * config:import, exactly like the recaptcha/mailchimp keys; their values
 * resolve live from Pantheon and are never stored in config. Creating them
 * here programmatically would clash with that config, and the pantheon_secrets
 * sync still coexists (it skips secrets already backed by a key via its
 * secret_name).
 *
 * Beacon is deliberately NOT switched on here, and the legacy ai_engine chat
 * is deliberately NOT switched off; a platform admin cuts a site over from
 * the Platform Admin Settings page instead. See "Cutting a site over from the
 * legacy ai_engine chatbot" in README.md for the procedure and why the deploy
 * cannot do it (yalesites-org/YaleSites-Internal#1459).
 */
function ys_beacon_install() {
  _ys_beacon_provision_settings();

  // Copy the legacy system instructions version history. Values are stored
  // unescaped (escaping only ever happened on the legacy API wire), and the
  // legacy service guarantees at most one is_active = 1 row.
  // Deployment ordering matters: uninstalling ys_ai_system_instructions
  // drops its table, so it must stay installed until after ys_beacon has
  // been installed (a same-deploy swap would silently skip this copy).
  $database = \Drupal::database();
  if ($database->schema()->tableExists('ys_ai_system_instructions')) {
    $rows = $database->select('ys_ai_system_instructions', 's')
      ->fields('s', ['instructions', 'version', 'created_by', 'created_date', 'is_active', 'notes'])
      ->orderBy('id')
      ->execute()
      ->fetchAll(\PDO::FETCH_ASSOC);
    foreach ($rows as $row) {
      $database->insert('ys_beacon_system_instructions')->fields($row)->execute();
    }
  }

  // Seed default system instructions on a fresh install (no legacy history to
  // copy). The helper no-ops when versions already exist, so migrations and
  // existing installs are never overwritten.
  _ys_beacon_seed_default_instructions($database);
}

/**
 * Provisions ys_beacon.settings: shipped defaults plus legacy chat values.
 *
 * Split out of hook_install() so ys_beacon_deploy_10001() can re-run the whole
 * provisioning after config:import, which deletes the object hook_install()
 * created moments earlier on a site receiving Beacon for the first time. See
 * ys_beacon.deploy.php for why the import does that and why the deploy phase is
 * the one that can make the write stick.
 *
 * Seed and overlay have to travel together: the legacy values are written into
 * the very object the import deletes, so restoring the shipped defaults on
 * their own would silently reset a migrated site's button text, prompts,
 * disclaimer and footer.
 */
function _ys_beacon_provision_settings(): void {
  // Seed the shipped defaults before anything else, so the legacy copy below
  // overlays them instead of writing into a config object that never existed.
  _ys_beacon_seed_settings();

  $settings = \Drupal::configFactory()->getEditable('ys_beacon.settings');
  $changed = FALSE;

  // The AI metadata fields visibility toggle lived in its own legacy config.
  $legacy_metadata = \Drupal::config('ai_engine_metadata.settings');
  if (!$legacy_metadata->isNew()) {
    $settings->set('enable_metadata_fields', (bool) $legacy_metadata->get('enable'));
    $changed = TRUE;
  }

  $legacy = \Drupal::config('ai_engine_chat.settings');
  if (!$legacy->isNew()) {
    $map = [
      'floating_button' => 'floating_button',
      'floating_button_text' => 'floating_button_text',
      'prompts' => 'prompts',
      'disclaimer' => 'disclaimer',
      'footer' => 'footer',
    ];
    foreach ($map as $target => $source) {
      $value = $legacy->get($source);
      // The legacy form saved starter questions under "prompts" but its
      // install default used "initial_questions"; accept either.
      if ($target === 'prompts' && ($value === NULL || $value === [])) {
        $value = $legacy->get('initial_questions');
      }
      if ($value !== NULL && $value !== '' && $value !== []) {
        $settings->set($target, $value);
        $changed = TRUE;
      }
    }
  }

  if ($changed) {
    $settings->save();
  }
}

/**
 * Fills any shipped default missing from ys_beacon.settings.
 *
 * Ys_beacon.settings is config_ignored, so it is deliberately absent from
 * config/sync. That matters on the install path this module actually takes on a
 * first-time site: ys_beacon is listed in core.extension, so config:import is
 * what installs it, and a module installed mid-import gets its default config
 * from the SYNC storage rather than from its own config/install directory
 * (ConfigInstaller::installDefaultConfig() branches on isSyncing()). Nothing
 * named ys_beacon.* exists in sync, so without this the settings object is
 * never created at all, and every key without a runtime fallback silently reads
 * NULL - turning streaming off and hiding the AI metadata fields, both of which
 * ship on.
 *
 * Reading the shipped file directly sidesteps that, and is the same approach
 * _ys_beacon_portkey_seed_settings() already takes for the same reason.
 *
 * This fills gaps rather than only creating an absent object, because the
 * settings can also come back partially populated. Once the import has deleted
 * them (yalesites-org/YaleSites-Internal#1491), the next runtime write
 * recreates the object holding only the handful of keys that writer sets -
 * BeaconPlatformAdminSetting::submitSettings() writes three, and
 * BeaconIndexManager::propagateConnection() two. An existence test would call
 * that healthy and leave every other key reading NULL for good. Existing values
 * always win, so this stays safe to call on a configured site.
 *
 * @return bool
 *   TRUE when a missing default was written, FALSE when nothing was needed.
 */
function _ys_beacon_seed_settings(): bool {
  $config = \Drupal::configFactory()->getEditable('ys_beacon.settings');
  $path = \Drupal::service('extension.list.module')->getPath('ys_beacon') . '/config/install';
  $shipped = (new FileStorage($path))->read('ys_beacon.settings');
  if (!$shipped) {
    return FALSE;
  }

  // Union, not merge: a key the site already holds is never overwritten.
  $current = $config->getRawData();
  $filled = $current + $shipped;
  if ($filled === $current) {
    return FALSE;
  }

  $config->setData($filled)->save();
  return TRUE;
}

/**
 * Seeds the canonical default system instructions when none exist yet.
 *
 * Inserts version 1 as the active instruction only when the table is empty, so
 * a migrated history or an existing install is never overwritten.
 *
 * @param \Drupal\Core\Database\Connection $database
 *   The active database connection.
 */
function _ys_beacon_seed_default_instructions(Connection $database) {
  if ((int) $database->select('ys_beacon_system_instructions')->countQuery()->execute()->fetchField() !== 0) {
    return;
  }

  // Keep this text in sync with the fallback_system_prompt default in
  // config/install/ys_beacon.settings.yml: this seeds the active versioned
  // instructions, while that key is the fallback used when none exist.
  $default_instructions = <<<'EOT'
# YaleSites AI System Instruction

## Identity & Purpose
You are an AI assistant embedded on a Yale University website. Your purpose is to help users find information available on this specific site, answer their questions about the site's content, and assist with navigating the resources presented here. You support Yale's mission of advancing knowledge through excellent service and clear communication.

## Information Sources
- You have access only to the content on this specific website where you are deployed
- Your knowledge is limited to what's published on this site
- You provide citations to specific pages or sections when answering

## Communication Approach
- **Empathetic**: Understand users' needs and respond with care
- **Concise**: Provide clear, direct answers without unnecessary elaboration
- **Nuanced**: Recognize complexity while offering accessible explanations
- **Accurate**: Only share information present on this site

## Response Guidelines
- Begin with a direct answer to the question when possible
- Keep responses brief but complete
- Use simple formatting to enhance readability
- Include specific citations to pages on this site
- Suggest relevant site links for additional information

## When You Don't Know
- Clearly acknowledge when information isn't available on this site
- Don't speculate beyond the site's content
- Suggest where on the site the user might look for related information
- Offer to help reformulate the question if appropriate
- Never pretend to know information not present on this site

## Interaction Style
- Be conversational but professional
- Match your language to the academic context
- Prioritize clarity over technical jargon
- Use inclusive language accessible to diverse audiences
- Maintain a warm, helpful tone that reflects Yale's values

## Technical Considerations
- You interact with site content that has been transformed into vector embeddings
- You can only access content that has been properly indexed from this site
- Your responses should respect the structure and organization of the site
- Citations should help users locate the original content on this site

## Ethical Guidelines
- Respect privacy by not asking for or storing personal information
- Maintain the academic integrity reflected on the site
- Uphold Yale's commitment to "the free exchange of ideas in an ethical, interdependent, and diverse community"
- Support accessibility through clear communication
- Prioritize helping users accomplish their goals efficiently
EOT;

  $database->insert('ys_beacon_system_instructions')
    ->fields([
      'instructions' => $default_instructions,
      'version' => 1,
      'created_by' => 0,
      'created_date' => \Drupal::service('datetime.time')->getRequestTime(),
      'is_active' => 1,
      'notes' => 'Default YaleSites system instructions',
    ])
    ->execute();
}

/**
 * Implements hook_update_last_removed().
 *
 * Updates 10001-10018 have been removed. They existed only to migrate
 * development environments while this module was being built on an unmerged
 * branch: ys_beacon has never shipped, so no production, test or live site has
 * ever had it installed, and a site receiving it for the first time gets its
 * schema version set straight to the newest update by
 * ModuleInstaller::install() - meaning not one of those hooks would ever have
 * run there. Everything they did is expressed in hook_schema() and
 * hook_install() (with the shipped config/install defaults), which is the state
 * a first-time install lands in directly.
 *
 * Declaring the highest removed number is what keeps that safe rather than
 * silent: a database still parked below it - only ever a local checkout or a
 * multidev of this branch - is refused with a clear error instead of quietly
 * skipping the migrations it still needs. Reset such a database from a fresh
 * pull instead.
 */
function ys_beacon_update_last_removed() {
  return 10018;
}
