{#
/**
 * @file
 * Distribution of Beacon chat turns per UTC day.
 *
 * Each bar carries its own date and count as real text inside a
 * visually-hidden span, so the chart is readable with a screen reader without
 * aria-label duplication and without a parallel data table. The bar height is
 * passed as a CSS custom property rather than a width/height declaration so the
 * stylesheet keeps control of the presentation.
 *
 * Available variables:
 * - bars: list of days, oldest first, each with date, count and percent.
 * - max: the busiest day's count, which the bars are scaled against.
 * - days: how many days the chart covers.
 * - total: chat turns across the whole window.
 */
#}
<figure class="ys-beacon-chart">
  <figcaption class="ys-beacon-chart__caption">
    {{ 'Chat turns per day'|t }}
    <span class="ys-beacon-chart__summary">
      {{ '@total turns over @days days, busiest day @max.'|t({'@total': total, '@days': days, '@max': max}) }}
    </span>
  </figcaption>

  {% if max > 0 %}
    <ol class="ys-beacon-chart__bars">
      {% for bar in bars %}
        {% set bar_label = '@date: @count turns'|t({'@date': bar.date, '@count': bar.count}) %}
        {#
          The same text twice, on purpose. The visually-hidden span is what makes
          the figures available to assistive technology and is the authoritative
          copy; title adds a hover tooltip for sighted mouse users, who otherwise
          could read the shape but not the numbers. Nothing is exclusive to the
          tooltip, so its known weaknesses - no touch, no keyboard - cost nothing.
        #}
        <li class="ys-beacon-chart__bar" style="--ys-beacon-chart-bar-height: {{ bar.percent }}%" title="{{ bar_label }}">
          <span class="visually-hidden">{{ bar_label }}</span>
        </li>
      {% endfor %}
    </ol>
    <p class="ys-beacon-chart__axis">
      <span>{{ (bars|first).date }}</span>
      <span>{{ (bars|last).date }}</span>
    </p>
  {% else %}
    <p>{{ 'No chat turns recorded yet.'|t }}</p>
  {% endif %}
</figure>
