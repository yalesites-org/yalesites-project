<?php

/**
 * @file
 * Contains ys_ai_tester.module functions.
 */

/**
 * Implements hook_theme().
 */
function ys_ai_tester_theme(): array {
  return [
    'ys_ai_tester_ai_export' => [
      'variables' => [
        'question_count' => 0,
        'run_a' => 0,
        'run_b' => 0,
        'label_a' => '',
        'label_b' => '',
        'prompt_id' => '',
        'download' => NULL,
        'copy' => NULL,
      ],
    ],
    // One tab per question, each revealing a panel of per-run answer columns.
    // 'columns' drives the panel grid class. Only the compare view renders
    // these today, and only ever at two columns; see
    // AiTesterController::questionTabs() for what one column would take.
    'ys_ai_tester_question_tabs' => [
      'variables' => [
        'tabs' => [],
        'panels' => [],
        'columns' => 2,
        'tablist_label' => '',
        'empty' => '',
      ],
    ],
  ];
}
