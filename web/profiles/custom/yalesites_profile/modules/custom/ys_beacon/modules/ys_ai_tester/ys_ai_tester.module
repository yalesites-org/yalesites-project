<?php

/**
 * @file
 * Contains ys_ai_tester.module functions.
 */

/**
 * Implements hook_theme().
 */
function ys_ai_tester_theme(): array {
  return [
    'ys_ai_tester_ai_export' => [
      'variables' => [
        'question_count' => 0,
        'run_a' => 0,
        'run_b' => 0,
        'label_a' => '',
        'label_b' => '',
        'prompt_id' => '',
        'download' => NULL,
        'copy' => NULL,
      ],
    ],
    // One tab per question, each revealing a panel of per-run answer columns.
    // The panel grid is fixed at two columns in the stylesheet: only the
    // compare view renders these, and a comparison is always two-sided.
    'ys_ai_tester_question_tabs' => [
      'variables' => [
        'tabs' => [],
        'panels' => [],
        'tablist_label' => '',
        'empty' => '',
      ],
    ],
  ];
}
