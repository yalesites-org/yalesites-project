{#
/**
 * @file
 * Label for a radio on the YaleSites theme settings form.
 *
 * Renders the option's palette colors beside its name. Shared by every setting
 * on the form; ys_themes_preprocess_form_element() decides which colors an
 * option gets.
 *
 * Available variables:
 * - title, title_display, required, attributes: as for form_element_label.
 * - element['#context']['swatches']: the option's colors, each with 'slot',
 *   'hex' and 'token_name'. Empty for an option with no colors, in which case
 *   only the title is rendered.
 * - element['#context']['swatches_follow_palette']: TRUE when the colors track
 *   the selected palette, which is what levers.js re-tints on palette change.
 *
 * Accessibility: the chips are hidden from assistive technology, because a
 * color is not something to announce. What matters is whether the visible
 * label already says what the option is. For the palettes it does ("Old
 * Blues"), so the name alone is enough. For the settings that follow the
 * palette the label is a bare ordinal ("One", "Two"), where the color *is* the
 * information -- so the token name is added as visually hidden text and the
 * option announces as "Two, Blue Yale". Either way color is never the only
 * means of conveying the choice (WCAG 1.4.1).
 *
 * @see template_preprocess_form_element_label()
 *
 * @ingroup themeable
 */
#}
{%
  set classes = [
    title_display == 'after' ? 'option',
    title_display == 'invisible' ? 'visually-hidden',
    required ? 'js-form-required',
    required ? 'form-required',
    'form-item__label',
  ]
%}
{% set swatches = element['#context']['swatches'] %}
{% set follows_palette = element['#context']['swatches_follow_palette'] %}

{% if title is not empty or required -%}
  <label{{ attributes.addClass(classes) }}>
    {{ title }}
    {% if swatches is not empty %}
      {% if follows_palette %}
        <span class="visually-hidden">
          {%- for swatch in swatches %}{{ swatch.token_name }}{{ loop.last ? '' : ', ' }}{% endfor -%}
        </span>
      {% endif %}
      <span class="colors" aria-hidden="true">
        {% for swatch in swatches %}
          <span class="{{ follows_palette ? 'color component-color' : 'color' }}" data-slot="{{ swatch.slot }}" style="background: {{ swatch.hex }};" title="{{ swatch.token_name }}"></span>
        {% endfor %}
      </span>
    {% endif %}
  </label>
{%- endif %}
