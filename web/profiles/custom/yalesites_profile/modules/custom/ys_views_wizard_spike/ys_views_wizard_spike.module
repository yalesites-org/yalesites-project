<?php

/**
 * @file
 * SPIKE for yalesites-org/YaleSites-Internal#1586 - prototype A.
 *
 * Retargets the single "View" tile in the Layout Builder block browser at a
 * two-question wizard route, and seeds the answers into the configure form
 * that the wizard redirects to. Throwaway - see README.md.
 */

use Drupal\Component\Serialization\Json;
use Drupal\block_content\BlockContentInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Url;
use Drupal\ys_views_wizard_spike\ViewsWizardOptions;

/**
 * Implements hook_layout_builder_browser_alter().
 *
 * This is the insertion point that needs no patch and no route override: the
 * browser hands us the finished render array plus the section storage, delta
 * and region, which are exactly the parameters the wizard route needs.
 */
function ys_views_wizard_spike_layout_builder_browser_alter(array &$build, array $contexts) {
  $wizard_url = Url::fromRoute('ys_views_wizard_spike.choose', [
    'section_storage_type' => $contexts['section_storage']->getStorageType(),
    'section_storage' => $contexts['section_storage']->getStorageId(),
    'delta' => $contexts['delta'],
    'region' => $contexts['region'],
  ]);

  foreach ($build['block_categories'] as &$category) {
    if (!is_array($category) || !isset($category['links'])) {
      continue;
    }
    foreach ($category['links'] as &$item) {
      if (!isset($item['link']['#url'])) {
        continue;
      }
      $parameters = $item['link']['#url']->getRouteParameters();
      if (($parameters['plugin_id'] ?? NULL) !== ViewsWizardOptions::TARGET_PLUGIN) {
        continue;
      }
      $item['link']['#url'] = $wizard_url;
      // layout_builder_browser_link_alter() only modalises the two core
      // layout_builder route names, so a custom route would open off-canvas
      // from inside the modal. Set the dialog attributes here instead.
      _ys_views_wizard_spike_modalize($item['link']['#attributes']);
    }
  }
}

/**
 * Implements hook_form_alter().
 */
function ys_views_wizard_spike_form_alter(array &$form, FormStateInterface $form_state, $form_id) {
  if ($form_id !== 'layout_builder_add_block') {
    return;
  }
  $seed = \Drupal::request()->query->get('ys_wizard_seed');
  if (!$seed || substr_count($seed, ':') !== 1) {
    return;
  }
  // Seed the ENTITY, not the form. At hook_form_alter() time `block_form`
  // holds only #type, #process, #block and #access - the radios do not exist
  // yet, they are built by that #process callback. But #block is the
  // BlockContent entity the widget will read, and ViewsBasicDefaultWidget
  // derives both the selected content type and the *set of display modes it
  // offers* from the stored params. Writing the params here is therefore the
  // only seeding point that gets both radios right; altering the built radios
  // later sets the checked type but leaves the display-mode list belonging to
  // the previous type.
  $block = $form['settings']['block_form']['#block'] ?? NULL;
  if (!$block instanceof BlockContentInterface || !$block->hasField('field_view_params')) {
    return;
  }
  [$content_type, $view_mode] = explode(':', $seed);
  $params = Json::decode($block->get('field_view_params')->params ?? '') ?: [];
  $params['filters']['types'] = [$content_type];
  $params['view_mode'] = $view_mode;
  $block->get('field_view_params')->params = Json::encode($params);
}

/**
 * Applies layout_builder_browser's modal attributes to a link.
 *
 * Mirrors layout_builder_browser_link_alter(), which cannot help here because
 * it whitelists only layout_builder.choose_block and layout_builder.add_block.
 *
 * @param array $attributes
 *   The link's #attributes array, altered by reference.
 */
function _ys_views_wizard_spike_modalize(array &$attributes) {
  if (!\Drupal::config('layout_builder_browser.settings')->get('use_modal')) {
    return;
  }
  if (!in_array('use-ajax', $attributes['class'] ?? [], TRUE)) {
    return;
  }
  $attributes['data-dialog-type'] = 'dialog';
  $attributes['data-dialog-options'] = Json::encode([
    'width' => '80%',
    'height' => 'auto',
    'target' => 'layout-builder-modal',
    'autoResize' => TRUE,
    'modal' => TRUE,
  ]);
  unset($attributes['data-dialog-renderer']);
}

/**
 * Implements hook_gin_lb_is_layout_builder_route_alter().
 *
 * The route half of the gin_lb opt-in; the form-id half needs a service
 * decorator because gin_lb fires no alter there. See GinLbContextValidator.
 */
function ys_views_wizard_spike_gin_lb_is_layout_builder_route_alter(bool &$is_layout_builder_route) {
  if (\Drupal::routeMatch()->getRouteName() === 'ys_views_wizard_spike.choose') {
    $is_layout_builder_route = TRUE;
  }
}
